class Solution:
    def maxPalindromes(self, s: str, k: int) -> int:
        n = len(s)

        # dp[i] = maximum palindromes using s[0:i]
        dp = [0] * (n + 1)

        for i in range(n):
            # Don't use a palindrome ending at i
            dp[i + 1] = dp[i]

            # Check palindrome of length k
            if i - k + 1 >= 0:
                if self.isPalindrome(s, i - k + 1, i):
                    dp[i + 1] = max(
                        dp[i + 1],
                        dp[i - k + 1] + 1
                    )

            # Check palindrome of length k + 1
            if i - k >= 0:
                if self.isPalindrome(s, i - k, i):
                    dp[i + 1] = max(
                        dp[i + 1],
                        dp[i - k] + 1
                    )

        return dp[n]
    def isPalindrome(self, s, left, right):
        while left < right:
            if s[left] != s[right]:
                return False
            left += 1
            right -= 1

        return True
