class Solution:
    def resultArray(self, nums: List[int], k: int) -> List[int]:
        dp = [0] * k
        ans = [0] * k

        for num in nums:
            new_dp = [0] * k

            # Start a new subarray with num
            r = num % k
            new_dp[r] += 1

            # Extend all previous subarrays
            for prev_r in range(k):
                if dp[prev_r]:
                    new_r = (prev_r * num) % k
                    new_dp[new_r] += dp[prev_r]

            dp = new_dp

            # All subarrays ending here contribute
            for r in range(k):
                ans[r] += dp[r]

        return ans
