class Solution:
    def isValid(self, s: str) -> bool:
        stack = []

        dict1 = {
            "(":")",
            "{":"}",
            "[":"]"
        }
        for char in s:
            if char in dict1:
                stack.append(dict1[char])
            else:
                if not stack:
                    return False
                if char != stack[-1]:
                    return False
                else:
                    stack.pop()
        return len(stack)==0
