class Solution:
    def checkOverlap(self, radius: int, xCentre: int, yCentre: int, x1: int, y1: int, x2: int, y2: int) -> bool:
        if xCentre < x1:
            closestX = x1
        elif xCentre > x2:
            closestX = x2
        else:
            closestX = xCentre

        if yCentre < y1:
            closestY = y1
        elif yCentre > y2:
            closestY = y2
        else:
            closestY = yCentre
        
        distance_squared = ((xCentre - closestX)**2 + (yCentre - closestY)**2)

        return distance_squared <= radius**2
