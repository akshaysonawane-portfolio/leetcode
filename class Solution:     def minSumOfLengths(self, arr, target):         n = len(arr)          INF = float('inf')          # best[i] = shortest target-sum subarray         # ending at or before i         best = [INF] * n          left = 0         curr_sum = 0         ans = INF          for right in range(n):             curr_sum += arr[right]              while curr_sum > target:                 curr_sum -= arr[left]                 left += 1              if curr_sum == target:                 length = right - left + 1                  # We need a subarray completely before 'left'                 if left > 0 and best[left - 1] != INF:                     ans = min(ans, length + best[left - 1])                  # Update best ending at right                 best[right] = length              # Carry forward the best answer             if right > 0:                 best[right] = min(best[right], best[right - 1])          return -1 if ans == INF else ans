class Solution:
    def minSumOfLengths(self, arr, target):
        n = len(arr)

        INF = float('inf')

        # best[i] = shortest target-sum subarray
        # ending at or before i
        best = [INF] * n

        left = 0
        curr_sum = 0
        ans = INF

        for right in range(n):
            curr_sum += arr[right]

            while curr_sum > target:
                curr_sum -= arr[left]
                left += 1

            if curr_sum == target:
                length = right - left + 1

                # We need a subarray completely before 'left'
                if left > 0 and best[left - 1] != INF:
                    ans = min(ans, length + best[left - 1])

                # Update best ending at right
                best[right] = length

            # Carry forward the best answer
            if right > 0:
                best[right] = min(best[right], best[right - 1])

        return -1 if ans == INF else ans
