class Solution:
    def evaluate(self, s: str, knowledge: list[list[str]]) -> str:
        result = []
        knowledge_dict = dict(knowledge)
        i = 0
        while i <len(s):
            
            if s[i] == "(":
                j = s.index(")", i)
                key = s[i+1:j]
                result.append(knowledge_dict.get(key,"?"))
                i =j+1

            elif s[i] != ")":
                result.append(s[i])
                i+=1
        return "".join(result)

            

            



        
